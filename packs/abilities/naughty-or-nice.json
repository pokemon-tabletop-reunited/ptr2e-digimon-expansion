          "target": "field",
          "distance": null,
          "unit": "m"
        },
        "power": null,
        "accuracy": null
      }
    ],
    "description": "<p>Connection: @UUID[Compendium.ptr2e.core-abilities.IY5l0838EgcytYTT]{Special Delivery} & @UUID[Compendium.ptr2e.core-abilities.LNMO8qdNnz530yQW]{Morning Fog}</p><p>Trigger: On Combat Start, the user may freely use Naughty or Nice's action as an @Trait[interrupt]. Otherwise, this attack may be used normally at it's full cost.</p>",
